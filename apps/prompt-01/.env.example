# Server-side settings for real Claude runs. Demo mode needs none of these.
ANTHROPIC_API_KEY=
# Set a model available to your account. Required for Messages API and Agent SDK.
CLAUDE_MODEL=
# Create and configure a text-analysis agent and environment in Claude Console.
MANAGED_AGENT_ID=
MANAGED_ENVIRONMENT_ID=
# Optional on Windows when the Agent SDK cannot locate Git Bash.
# CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
PORT=4010
