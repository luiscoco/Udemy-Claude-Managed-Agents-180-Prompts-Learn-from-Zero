# API key mode: put your real value here, never in source code.
ANTHROPIC_API_KEY=
# Existing agent to retrieve for the optional read-only verification.
AGENT_ID=
# Optional workspace header for an API key not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
# For auth:cli, first run: ant auth login --profile lesson
ANTHROPIC_PROFILE=lesson
PORT=4040
