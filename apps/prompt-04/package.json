{
  "name": "claude-prompt-04-authentication",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "auth:check": "tsx --env-file-if-exists=.env src/main.ts",
    "auth:cli": "tsx --env-file-if-exists=.env src/main.ts --cli",
    "start:test": "tsx tests/browser-server.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts",
    "test:e2e": "playwright test --project=chromium",
    "record": "playwright test tests/lesson.spec.ts --project=lesson"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "prismjs": "1.30.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}

